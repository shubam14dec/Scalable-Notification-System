# Template for the production `.env.prod` (chmod 600, NEVER committed — see
# .gitignore). One shared file is loaded by api, worker and ws, which is what
# guarantees JWT_SECRET is byte-identical across them.
#
# Generate every <gen> with `openssl rand -base64 48`; the two marked
# `<gen hex>` with `openssl rand -hex 32`.

TUNNEL_ID=<UUID>

POSTGRES_USER=asyncify
POSTGRES_PASSWORD=<gen>
POSTGRES_DB=notifications
DATABASE_URL=postgres://asyncify:<same>@postgres:5432/notifications

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=<gen>                    # identical api+ws by shared env_file
CREDENTIALS_ENCRYPTION_KEY=<gen>    # LOSS BRICKS ALL INTEGRATIONS — back up off-box NOW
WEBHOOK_SIGNING_SECRET=<gen hex>
# Operator-only secret gating global ops writes (public-url); generate with
# openssl rand -hex 32; NOT a tenant key. Sent as x-operator-token; without it
# preflight refuses to boot.
OPS_ADMIN_TOKEN=<gen hex>
OUTBOUND_URL_ALLOW=                 # MUST stay empty (SSRF guard)

PUBLIC_URL=https://app.asyncify.org # boot fallback; runtime value lives in Redis

# The OPERATOR mail path (S1.7a): password-reset links go out through this,
# never through a tenant's provider chain. Leave SMTP_HOST empty and
# /auth/forgot still answers 200 but delivers nothing. Resend's SMTP mode uses
# the literal user `resend` with a Resend API key as the password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=notifications@asyncify.org

CLICKHOUSE_ENABLED=true
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=notifications
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<gen hex>

OTEL_ENABLED=false

# "Continue with Google" — OPTIONAL; leave both empty to keep the feature off
# (the login page then shows email + password only). The console client must
# have https://app.asyncify.org/auth/google/callback registered as an
# authorized redirect URI. POST_LOGIN_ORIGIN stays EMPTY in production: the
# dashboard and the API are the same origin behind Caddy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_POST_LOGIN_ORIGIN=

EMAIL_CHAOS_RATE=0
WORKER_TIERS=p0,p1,p2
